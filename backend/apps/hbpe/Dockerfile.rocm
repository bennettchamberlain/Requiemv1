# Built from the repository root, not this directory: ci-hbpe installs
# ci-telemetry from backend/packages/telemetry, which a context rooted here
# could not reach. See the `build` target in the Makefile for the context.

# The uv version comes from required-version in the root pyproject.toml;
# `make build` extracts it and passes it as UV_VERSION. There is no default
# on purpose: a bare `docker build` fails at the FROM below rather than
# building with a uv the rest of the toolchain is not pinned to.
ARG UV_VERSION
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ══════════════════════════════════════════════════════════════════════════════
# BUILDER — compiles the HIP backend, then is thrown away.
# ══════════════════════════════════════════════════════════════════════════════
# The ROCm SDK must be IN this image, not on the host. Compiling the GGML HIP
# backend needs hipcc and the HIP/rocBLAS headers at BUILD time, and a build
# container has no access to the host's /opt/rocm — nor to /dev/kfd and
# /dev/dri, which are runtime device nodes and are never mounted during
# `docker build`. Until this was fixed the image inherited python:3.11-slim
# (the CPU image's base) and passed a HIP flag anyway; see the note on the
# llama-cpp-python layer below for why that went unnoticed for months.
#
# Pinned to the same ROCm the appliance runs (7.2.x). The container ships ROCm
# USERSPACE; the kernel driver is the host's, shared through /dev/kfd. Newer
# userspace against an older kernel driver is the direction that breaks, so
# this tracks the host rather than the newest published tag.
#
# `-complete` rather than the smaller plain `dev` tag: the GGML HIP backend
# links hipBLAS/rocBLAS, which the stripped image does not carry. It costs
# ~7 GB compressed and 21.7 GB on disk — which is exactly why it is confined to
# this stage and never shipped.
FROM rocm/dev-ubuntu-22.04:7.2.4-complete AS builder

# Python 3.11 and the toolchain. Same shape as Dockerfile.cuda, which also
# builds on an Ubuntu 22.04 vendor image: the distro's own python3 is 3.10
# here, and .python-version pins 3.11.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    cmake \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

# ROCM_PATH and /opt/rocm/bin are set explicitly rather than relied on from the
# base image: CMake's HIP language detection resolves the compiler through
# them, and "The HIP compiler identification is unknown" is what it reports
# when it cannot.
ENV VIRTUAL_ENV=/app/.venv \
    ROCM_PATH=/opt/rocm \
    PATH=/app/.venv/bin:/opt/rocm/bin:$PATH \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# ── Locked dependencies ───────────────────────────────────────────────────────
# See backend/apps/hbpe/Dockerfile for why only this image's own manifests
# are copied and synced with --frozen. The lock pins torch to the PyTorch
# CPU build on Linux, so this image excludes it from the sync and installs
# the ROCm build from the hardware index below.
#
# The ROCm image gets the portable onnxruntime from the lock: the marker in
# ci-hbpe's pyproject.toml only selects onnxruntime-gpu, which is a CUDA
# build, on linux-x86_64. Enabling the ROCm execution provider means pinning
# a matching onnxruntime-rocm, which is still outstanding.
COPY pyproject.toml uv.lock .python-version ./
COPY backend/apps/hbpe/pyproject.toml ./backend/apps/hbpe/pyproject.toml
COPY backend/packages/telemetry/pyproject.toml ./backend/packages/telemetry/pyproject.toml

RUN uv sync --frozen --package ci-hbpe --no-install-workspace --no-dev \
    --no-install-package torch

# ── GPU-specific packages ─────────────────────────────────────────────────────
# These must come after `uv sync`, not before it. Sync makes the environment
# match the lock exactly, which means it removes anything the lock does not
# mention — including everything installed here.

# PyTorch built against ROCm 7.2, matching the base image. PyTorch publishes a
# separate wheel index per ROCm minor; pointing at one that predates the SDK in
# the image (this was rocm6.1 against a base with no ROCm at all) gets you
# wheels linked to runtime libraries that are not there.
RUN uv pip install --no-cache \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/rocm7.2

# llama-cpp-python (JamePeng fork — required for Qwen3.5 support), the same
# pinned commit every HBPE image builds (LLAMA_CPP_PYTHON_REF in the
# Makefile), here with the GGML HIP backend for AMD cards.
#
# GGML_HIP=ON, not the GGML_HIPBLAS=ON this image used against the official
# package: llama.cpp renamed the flag, and on the fork's newer llama.cpp the
# old name is ignored — the build would silently produce a CPU-only wheel.
# That silence is why the missing SDK went unnoticed: for months CMake never
# tried to configure HIP, so it never looked for a compiler that was not there,
# and every "ROCm" image shipped a CPU-only wheel that worked well enough that
# nobody questioned it.
#
# AMDGPU_TARGETS is the gfx architecture of the card this appliance actually
# has (gfx1100 for an RX 7900, gfx1030 for a 6800/6900), detected by
# scripts/detect-gpu.sh and passed by `make build`. Left empty the build falls
# back to llama.cpp's own default target list — which is slow to compile and
# is not guaranteed to include this host's card. It is deliberately NOT
# defaulted to a value here: a wrong architecture compiled in produces a wheel
# that loads and then finds no usable device at runtime.
ARG LLAMA_CPP_PYTHON_REF
ARG AMDGPU_TARGETS
RUN CMAKE_ARGS="-DGGML_HIP=ON${AMDGPU_TARGETS:+ -DAMDGPU_TARGETS=$AMDGPU_TARGETS}" FORCE_CMAKE=1 \
    uv pip install --no-cache \
      "llama-cpp-python @ git+https://github.com/JamePeng/llama-cpp-python.git@${LLAMA_CPP_PYTHON_REF:?set by make build}"

# ── Application code ──────────────────────────────────────────────────────────
COPY backend/apps/hbpe/src ./backend/apps/hbpe/src
COPY backend/packages/telemetry/src ./backend/packages/telemetry/src
COPY backend/apps/hbpe/scripts ./scripts

# `uv pip install`, not a second `uv sync`, because sync would prune the
# GPU-specific packages installed above. --no-deps because the dependencies
# are already installed from the lock.
RUN uv pip install --no-cache --no-deps ./backend/packages/telemetry ./backend/apps/hbpe

# ── Trim the vendor kernel bundles, HERE rather than in the runtime stage ─────
# rocBLAS and hipBLASLt carry one tuned kernel bundle per GPU architecture, and
# they are the largest thing the runtime stage ships — 4.48 GB for hipBLASLt,
# 0.63 GB for rocBLAS. The CDNA datacenter parts dominate: gfx942 (MI300) alone
# is 2.99 GB, two thirds of hipBLASLt, and the four together are ~4.2 GB.
#
# This appliance runs on consumer hardware, so those four go and every RDNA
# target stays: gfx1030 (RX 6800/6900), gfx1100-1103 (RX 7000 and the Phoenix
# APU), gfx1150/1151 (Strix APUs) and gfx1200/1201 (RX 9000). Pruning by
# ARCHITECTURE CLASS rather than down to AMDGPU_TARGETS is deliberate: the
# image stays portable across the cards this actually ships to, instead of
# being silently pinned to whichever GPU happened to build it. AMDGPU_TARGETS
# pins the llama.cpp COMPILE to one architecture, which is right for a local
# build and wrong for vendor kernels another consumer card still needs.
#
# It runs in the BUILDER, not next to the COPY that consumes it, because layers
# are additive: deleting these files after the copy writes a whiteout and
# reclaims nothing — the first attempt at this left the image byte-for-byte the
# same size. Pruning before the copy is what actually makes the layer smaller.
#
# Set PRUNE_GFX_ARCHS empty to keep everything, which is what a datacenter
# deployment would need. The substrings are unambiguous: none of gfx908,
# gfx90a, gfx942 or gfx950 occurs inside an RDNA target's name.
ARG PRUNE_GFX_ARCHS="gfx908 gfx90a gfx942 gfx950"
RUN for arch in $PRUNE_GFX_ARCHS; do \
      find /opt/rocm/lib/rocblas/library /opt/rocm/lib/hipblaslt/library \
           -name "*$arch*" -delete; \
    done \
    # Guard against a glob that ate too much: the consumer bundles are the
    # entire point of keeping these directories, and their absence would not
    # surface until a matmul failed at dispatch time, far from this line.
    && for dir in rocblas hipblaslt; do \
         ls /opt/rocm/lib/$dir/library | grep -q 'gfx1[0-2]' \
           || { echo "PRUNE_GFX_ARCHS removed every consumer kernel from $dir"; exit 1; }; \
       done

# ══════════════════════════════════════════════════════════════════════════════
# RUNTIME — what actually ships.
# ══════════════════════════════════════════════════════════════════════════════
# The plain `dev` tag, not `-complete`: 1.1 GB compressed against 7.3 GB. It
# carries the HIP runtime (libamdhip64, libamd_comgr) and nothing else, so the
# math libraries the GGML HIP backend links are copied in from the builder
# below — pinned to the identical ROCm build by construction, which apt could
# not guarantee.
#
# What this stage deliberately leaves behind is most of the 19 GB in the
# builder's /opt/rocm/lib: the LLVM toolchain (2.3 GB), the device-operation
# static archives (2.1 GB + 1.9 GB, link-time only), the headers, and every
# math library nothing here links — rocFFT, rocSOLVER, rocRAND and MIOpen are
# all reachable through torch's own bundled copies in the venv, not through
# /opt/rocm.
FROM rocm/dev-ubuntu-22.04:7.2.4

# Runtime Python only — no -dev headers, no compiler, no git. The venv carries
# its own packages but still links the system libpython3.11, and the
# interpreter it was created against has to exist at the same path.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# The math libraries libggml-hip.so links, plus their kernel data.
#
# This list is DERIVED, not guessed — guessing it cost a build. `ldd` on the
# built backend gives the flattened closure; everything in it that the plain
# runtime base does not already carry has to be copied:
#
#   docker build --target builder -t hbpe-builder .
#   docker run --rm --entrypoint sh hbpe-builder -c \
#     'ldd /app/.venv/lib/python3.11/site-packages/llama_cpp/lib/libggml-hip.so \
#        | sed -n "s|.*=> \(/opt/rocm[^ ]*\).*|\1|p" | xargs -rn1 readlink -f | sort -u'
#
# The base already provides the HIP core — libamdhip64, libamd_comgr,
# libhsa-runtime64, librocprofiler-register, libroctx64 — leaving these five.
# rocSOLVER and rocROLLER are the non-obvious pair: nothing here calls a solver
# directly, but rocBLAS links them, so omitting them fails at import with
# "Failed to load 'ggml'" rather than anything mentioning a solver.
COPY --from=builder /opt/rocm/lib/libhipblas.so* /opt/rocm/lib/
COPY --from=builder /opt/rocm/lib/libhipblaslt.so* /opt/rocm/lib/
COPY --from=builder /opt/rocm/lib/librocblas.so* /opt/rocm/lib/
COPY --from=builder /opt/rocm/lib/librocsolver.so* /opt/rocm/lib/
COPY --from=builder /opt/rocm/lib/librocroller.so* /opt/rocm/lib/

# rocBLAS and hipBLASLt keep their tuned kernels in a `library/` directory
# beside the .so and fail at first dispatch without it, so those come whole —
# already trimmed to the consumer architectures in the builder stage, which is
# the only place a deletion actually shrinks the result.
COPY --from=builder /opt/rocm/lib/rocblas /opt/rocm/lib/rocblas
COPY --from=builder /opt/rocm/lib/hipblaslt /opt/rocm/lib/hipblaslt

WORKDIR /app

# PYTHONPATH is deliberately not set: the service is an installed distribution
# now, not a directory on the import path.
ENV VIRTUAL_ENV=/app/.venv \
    ROCM_PATH=/opt/rocm \
    PATH=/app/.venv/bin:/opt/rocm/bin:$PATH \
    MODELS_DIR=/app/models \
    HF_HOME=/app/models/hf_cache

RUN useradd -m -u 1000 hbpe

# `--chown` on the copy, NOT a `RUN chown -R` afterwards. Layers are
# copy-on-write per file, so recursively changing ownership rewrites every file
# into a new layer — a byte-identical second copy of the whole venv. That one
# line cost 16.6 GB here (and still costs 1.7 GB in the published CPU image,
# a third of its size).
COPY --from=builder --chown=hbpe:hbpe /app /app

COPY LICENSE.md /LICENSE.md
COPY --chmod=755 backend/apps/hbpe/entrypoint.sh ./entrypoint.sh

# Persistent volumes for model artifacts and token corpus
RUN mkdir -p /app/models/qwen \
             /app/data/token_corpus \
             /app/data/artifacts \
    && chown -R hbpe:hbpe /app/models /app/data

# ── One HIP runtime per process ───────────────────────────────────────────────
# Without this, importing llama_cpp and torch into the same process and letting
# both touch the GPU aborts the interpreter:
#
#   F hip.cpp:512] hipApiName has non-null function pointer 1 despite this
#   being the first instance of the library being copies
#     @ rocprofiler_register_library_api_table
#     @ hipGetDeviceCount  @ c10::cuda::device_count()
#
# There are two copies of libamdhip64 in the image: llama-cpp-python links the
# one in /opt/rocm, while the PyTorch ROCm wheel bundles its own under
# torch/lib. rocprofiler-register notices the second registration of the HIP API
# table and calls it fatal. It is not an ordering problem — it aborts whichever
# library initialises second — and none of ROCPROFILER_REGISTER_FORCE_LOAD,
# HSA_TOOLS_LIB or ROCP_DISABLE suppress it.
#
# Preloading the system runtime collapses both onto one copy. That is only safe
# because the base image's ROCm and the torch wheel's ROCm are the same minor
# (7.2) — which is the real reason those two pins have to move together, and
# what a bump to a newer ROCm must re-check.
#
# HBPE reaches this: inference/qwen.py drives llama_cpp while the model/ and
# pipeline/ modules are all torch.
ENV LD_PRELOAD=/opt/rocm/lib/libamdhip64.so

USER hbpe

# HBPE histogram API
EXPOSE 8002

CMD ["./entrypoint.sh"]
