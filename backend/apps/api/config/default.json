{
  "host": "127.0.0.1",
  "port": 3030,
  "frontend": {
    "url": "http://dev.companionintelligence.com"
  },
  "api": {
    "url": "http://dev.companionintelligence.com"
  },
  "providers": {
    "google": {
      "id": "018f8b9a-1234-7000-8000-000000000001",
      "name": "Google"
    },
    "microsoft": {
      "id": "018f8b9a-1234-7000-8000-000000000006",
      "name": "Microsoft"
    }
  },
  "logging": {
    "level": "info"
  },
  "auth": {
    "local": {
      "saltRounds": 10
    },
    "jwt": {
      "authTokenSecret": "AUTH_TOKEN_SECRET",
      "authTokenExpiration": "5m",
      "refreshTokenSecret": "AUTH_REFRESH_TOKEN_SECRET",
      "refreshTokenExpiration": "7d"
    },
    "session": {
      "saltRounds": 4,
      "fieldPepper": "AUTH_SESSION_PEPPER",
      "duration": "7d"
    }
  },
  "db": {
    "type": "postgres",
    "host": "127.0.0.1",
    "port": 5432,
    "database": "companion_intel",
    "username": "POSTGRES_USERNAME",
    "password": "POSTGRES_PASSWORD",
    "logging": ["error"]
  },
  "staticfiles": {
    "storageUrl": "http://localhost:9000",
    "region": "us-east-1",
    "bucket": "companion",
    "auth": {
      "signatureUrl": "http://minio:9000",
      "signatureTTL": 60,
      "accessKeyId": "S3_ACCESS_KEY_ID",
      "secretAccessKey": "S3_SECRET_ACCESS_KEY"
    }
  }
