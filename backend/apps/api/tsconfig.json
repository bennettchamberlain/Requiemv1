{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "commonjs",
    "target": "ES2020",
    "types": ["node"],
    "resolveJsonModule": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
  },
  "include": ["src", "scripts"],
  "exclude": ["dist", "node_modules"],
  "ts-node": {
    "files": true
  },
}
