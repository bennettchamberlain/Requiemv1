-- migrate:up
-- =================================================================
-- SYSTEM USERS TABLE - AUTHENTICATION & AUTHORIZATION
-- =================================================================
-- System users for authentication, API access, and permissions
-- Actual people are stored as entities in the graph system

CREATE TABLE users (
    user_id UUID PRIMARY KEY DEFAULT gen_uuid_v7(),
    entity_id UUID REFERENCES entities(entity_id), 
    
    -- Authentication
    username TEXT UNIQUE NOT NULL,
    email TEXT UNIQUE,
    password_hash TEXT, -- For local authentication
    settings JSONB DEFAULT '{}', -- User-specific settings
    
    -- External API Keys (OpenAI, Google, etc.)
    api_keys JSONB DEFAULT '{}', -- Dictionary of platform API keys
    
    -- System permissions and roles
    role TEXT NOT NULL DEFAULT 'user' CHECK (role IN ('admin', 'user', 'readonly', 'api_only')),
    permissions JSONB DEFAULT '{}', -- Granular permissions
    
    -- Session management
    last_login_at TIMESTAMPTZ,
    login_count INTEGER DEFAULT 0,
    failed_login_attempts INTEGER DEFAULT 0,
    
    -- System preferences
    timezone TEXT DEFAULT 'UTC',
    language TEXT DEFAULT 'en',
    display_preferences JSONB DEFAULT '{}', -- UI preferences
    
    -- Optional link to person entity in graph
    person_entity_id UUID, -- FK to entities table (will be added after entities table exists)
    
    -- Account status
    is_active BOOLEAN DEFAULT TRUE,
    is_verified BOOLEAN DEFAULT FALSE,
    verification_token TEXT,
    verification_expires_at TIMESTAMPTZ,
    locked_until TIMESTAMPTZ, -- Account lock expiration timestamp
    
    -- Audit fields
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    created_by UUID REFERENCES users(user_id) -- Who created this account
);

-- Indexes for authentication and lookups
CREATE INDEX users_username_idx ON users(username) WHERE is_active = TRUE;
CREATE INDEX users_email_idx ON users(email) WHERE email IS NOT NULL AND is_active = TRUE;
CREATE INDEX users_api_keys_gin_idx ON users USING GIN (api_keys); -- For API key platform searches
CREATE INDEX users_role_active_idx ON users(role, is_active);
CREATE INDEX users_person_entity_idx ON users(person_entity_id) WHERE person_entity_id IS NOT NULL;
CREATE INDEX users_created_idx ON users(created_at);
CREATE INDEX users_last_login_idx ON users(last_login_at) WHERE last_login_at IS NOT NULL;

-- migrate:down
-- Drop indexes first
DROP INDEX IF EXISTS users_last_login_idx;
DROP INDEX IF EXISTS users_created_idx;
DROP INDEX IF EXISTS users_person_entity_idx;
DROP INDEX IF EXISTS users_role_active_idx;
DROP INDEX IF EXISTS users_api_keys_gin_idx;
DROP INDEX IF EXISTS users_email_idx;
DROP INDEX IF EXISTS users_username_idx;

-- Drop table
DROP TABLE IF EXISTS users;
