<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Memory</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.companionintelligence.app.oidc</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>companion</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Companion uses the camera to capture photos and videos for your memory.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Companion connects to your Companion appliance on your local network, so your notes, photos and events stay on hardware you control.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Companion records a place when you leave an area — so your memory can attach where you were to notes, photos and events, even after you leave the app. Locations are sent only to your own Companion server. Companion does not stream a live track.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Companion records where you are while you use it, so your memory can place your notes, photos and events on a map. Locations are sent only to your own Companion server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Companion uses the microphone to record audio and video for your memory.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Companion saves captured media to your photo library when you choose to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Companion reads photos you choose so you can save them to your memory.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Companion turns your speech into text on this device so you can dictate notes and talk to your memory.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
