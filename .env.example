# Copy to .env. Never commit real keys.

# You.com (grounding). Event key from key.txt as YOU_WEB_SEARCH_TOKEN.
YDC_API_KEY=
YOU_WEB_SEARCH_TOKEN=

# Parasail (swarm brain + cloud embeddings)
PARASAIL_API_KEY=
PARASAIL_BASE_URL=https://api.parasail.io/v1
PARASAIL_MODEL=parasail-glm-53-flash
PARASAIL_EMBED_MODEL=parasail-bge-m3

# Scoria
SCORIA_API_URL=http://127.0.0.1:8090
SCORIA_SESSION_SECRET=
SCORIA_INTERNAL_SECRET=
SCORIA_API_TOKEN=
SCORIA_PG_URL=postgres://scoria:scoria@127.0.0.1:5433/scoria
GEL_DSN=gel://admin@127.0.0.1:5656/main
GEL_CLIENT_TLS_SECURITY=insecure
OLLAMA_URL=http://127.0.0.1:11434

# One (fill after `one init` and Connect app creation)
ONE_SECRET=
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_CONNECT_KEY=
ONE_REDIRECT_URI=http://127.0.0.1:8788/api/one/callback
ONE_PERMISSION_SET=
ONE_CONNECTION_KEYS=

CONNECT_PORT=8788
